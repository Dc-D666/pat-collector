---
// MDUI2 导航栏组件
const { current = '' } = Astro.props;
---

<mdui-top-app-bar variant="small" style="position:sticky;top:0;z-index:100;">
  <mdui-button-icon icon="smart_display" slot="icon"></mdui-button-icon>
  <mdui-top-app-bar-title>PatPlayer</mdui-top-app-bar-title>
  <div style="flex-grow:1"></div>
  <span id="userDisplay" style="font-size:14px;margin-right:8px;color:var(--mdui-color-on-surface-variant)"></span>
  <mdui-button-icon icon="lock" id="changePwdBtn" title="修改密码"></mdui-button-icon>
  <mdui-button-icon icon="logout" onclick="logout()"></mdui-button-icon>
</mdui-top-app-bar>

<!-- 底部导航栏（移动端） -->
<mdui-bottom-app-bar style="position:fixed;bottom:0;z-index:100;display:none;" class="mobile-nav">
  <mdui-button-icon icon="folder" href="/dashboard"></mdui-button-icon>
  <mdui-button-icon icon="photo_library" href="/class-wall"></mdui-button-icon>
  <mdui-button-icon icon="bar_chart" href="/overview"></mdui-button-icon>
  <div style="flex-grow:1"></div>
</mdui-bottom-app-bar>

<style>
  @media (max-width: 600px) {
    .mobile-nav { display: flex !important; }
    body { padding-bottom: 80px; }
  }
</style>

<!-- 侧边导航栏（桌面端） -->
<mdui-navigation-rail style="position:fixed;left:0;top:64px;height:calc(100vh - 64px);z-index:50;display:flex;" class="desktop-rail">
  <mdui-navigation-rail-item icon="folder" href="/dashboard">我的文件</mdui-navigation-rail-item>
  <mdui-navigation-rail-item icon="photo_library" href="/class-wall">班级作品墙</mdui-navigation-rail-item>
  <mdui-navigation-rail-item icon="bar_chart" href="/overview">提交总览</mdui-navigation-rail-item>
</mdui-navigation-rail>

<style>
  @media (max-width: 840px) {
    .desktop-rail { display: none !important; }
  }
  /* 侧边栏存在时，主内容需要偏移 */
  @media (min-width: 841px) {
    main, .page-content {
      margin-left: 80px;
    }
  }
</style>

<script>
  (async () => {
    const token = localStorage.getItem('patplayer_token');
    if (!token) { window.location.href = '/'; return; }
    try {
      const res = await fetch(`${window.location.origin}/api/auth/me`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (!res.ok) {
        localStorage.removeItem('patplayer_token');
        window.location.href = '/';
        return;
      }
      const user = await res.json();
      const el = document.getElementById('userDisplay');
      if (el) el.textContent = `${user.className}班 ${user.name}`;
    } catch {
      window.location.href = '/';
    }
  })();
</script>
