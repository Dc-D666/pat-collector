---
// 全局布局组件 - 使用 MDUI2 组件库
import 'mdui/mdui.css';
const { title = 'PatPlayer' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - 作品收集管理系统</title>
  <meta name="description" content="高中AI社团作品收集管理系统" />
  <style>
    .app-body { margin:0; background:var(--mdui-color-surface-container-low, #f5f5f5); }
  </style>
</head>
<body class="app-body">
  <slot />

  <!-- MDUI2 组件注册 + 全局工具函数 -->
  <script type="module">
    import 'mdui';

    window.API_BASE = window.location.origin;

    // 退出登录
    window.logout = () => {
      localStorage.removeItem('patplayer_token');
      window.location.href = '/';
    };

    // 格式化文件大小
    window.formatSize = (bytes) => {
      if (!bytes || bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    };

    // 格式化时间
    window.formatTime = (iso) => {
      if (!iso) return '-';
      const d = new Date(iso);
      return d.toLocaleString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit',
      });
    };

    // 文件图标映射
    window.getFileIcon = (name) => {
      const ext = name.split('.').pop()?.toLowerCase();
      const map = {
        jpg:'image', jpeg:'image', png:'image', gif:'gif', bmp:'image', webp:'image', svg:'image',
        mp4:'movie', webm:'movie', mov:'movie', avi:'movie',
        mp3:'music_note', wav:'music_note', ogg:'music_note',
        pdf:'picture_as_pdf', doc:'description', docx:'description',
        xls:'table_chart', xlsx:'table_chart', ppt:'slideshow', pptx:'slideshow',
        zip:'folder_zip', rar:'folder_zip', '7z':'folder_zip',
        py:'code', js:'code', html:'code', css:'code', cpp:'code', c:'code', java:'code',
        psd:'palette', ai:'palette', blend:'view_in_ar', fbx:'view_in_ar', obj:'view_in_ar',
        txt:'article', md:'article',
      };
      return map[ext] || 'insert_drive_file';
    };
  </script>
</body>
</html>
