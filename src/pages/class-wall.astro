---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
---

<Layout title="班级作品墙">
  <NavBar current="class-wall" />

  <main class="page-content ov-main">
    <div class="ov-header">
      <h1 class="ov-title">
        <mdui-icon name="photo_library" class="ov-title-icon"></mdui-icon>班级作品墙
      </h1>
      <p class="ov-subtitle" id="classTitle">加载中...</p>
    </div>

    <mdui-text-field id="searchInput" label="搜索同学姓名或文件名" variant="outlined"
      icon="search" class="search-field"></mdui-text-field>

    <div id="wallContent" class="wall-list"></div>

    <div id="wallEmpty" class="wall-empty">
      <mdui-icon name="inbox" class="empty-icon"></mdui-icon>
      <p class="empty-text">班级还没有同学提交作品</p>
    </div>
  </main>
</Layout>

<style>
  .ov-main { max-width:960px; margin:0 auto; padding:16px; }
  .ov-header { margin-bottom:20px; }
  .ov-title { margin:0 0 4px; font-size:24px; font-weight:700; }
  .ov-title-icon { vertical-align:middle; margin-right:6px; }
  .ov-subtitle { margin:0; font-size:14px; color:var(--mdui-color-on-surface-variant); }
  .search-field { max-width:400px; margin-bottom:16px; width:100%; }
  .wall-list { display:flex; flex-direction:column; gap:12px; }
  .wall-empty { display:none; text-align:center; padding:48px 16px; }
  .empty-icon { font-size:64px; color:var(--mdui-color-outline-variant); }
  .empty-text { color:var(--mdui-color-on-surface-variant); }
  .loading-card { text-align:center; padding:32px; color:var(--mdui-color-on-surface-variant); }
  .error-card { text-align:center; padding:32px; color:var(--mdui-color-error); }
  .student-header { padding:12px 16px; background:var(--mdui-color-surface-container); display:flex; align-items:center; justify-content:space-between; }
  .student-left { display:flex; align-items:center; gap:8px; }
  .student-time { font-size:12px; color:var(--mdui-color-on-surface-variant); }
  .file-icon { font-size:24px; color:var(--mdui-color-primary); }
  .file-info-name { font-weight:500; font-size:14px; }
  .file-info-meta { font-size:12px; color:var(--mdui-color-on-surface-variant); }
</style>

<script>
  var API_BASE = window.location.origin;
  var TOKEN = localStorage.getItem('patplayer_token');
  if (!TOKEN) window.location.href = '/';

  function authHeaders() { return { Authorization: 'Bearer ' + TOKEN }; }

  async function loadWall() {
    var content = document.getElementById('wallContent');
    var empty = document.getElementById('wallEmpty');
    var title = document.getElementById('classTitle');
    content.innerHTML = '<mdui-card variant="outlined" class="loading-card">加载中...</mdui-card>';
    empty.style.display = 'none';

    try {
      var res = await fetch(API_BASE + '/api/class/wall', { headers: authHeaders() });
      var data = await res.json();
      if (!res.ok) throw new Error(data.error);

      title.textContent = (data.className || '') + ' 班 - 共 ' + data.students.length + ' 位同学提交';
      if (data.students.length === 0) { content.innerHTML = ''; empty.style.display = 'block'; return; }
      renderWall(data.students);
    } catch (err) {
      content.innerHTML = '<mdui-card variant="outlined" class="error-card">加载失败: ' + err.message + '</mdui-card>';
    }
  }

  function renderWall(students) {
    var content = document.getElementById('wallContent');
    var searchInput = document.getElementById('searchInput');

    function render(list) {
      content.innerHTML = '';
      if (list.length === 0) {
        content.innerHTML = '<mdui-card variant="outlined" class="loading-card">没有匹配的结果</mdui-card>';
        return;
      }
      for (var i = 0; i < list.length; i++) {
        var s = list[i];
        var card = document.createElement('mdui-card');
        card.setAttribute('variant', 'elevated');

        var hdr = document.createElement('div');
        hdr.className = 'student-header';

        var left = document.createElement('div');
        left.className = 'student-left';
        left.innerHTML = '<mdui-icon name="person" style="color:var(--mdui-color-primary);"></mdui-icon>' +
          '<span style="font-weight:600;">' + escapeHtml(s.name) + '</span>' +
          '<mdui-chip style="font-size:12px;">' + s.fileCount + ' 个文件</mdui-chip>';

        var timeSpan = document.createElement('span');
        timeSpan.className = 'student-time';
        timeSpan.textContent = s.lastSubmit ? formatTime(s.lastSubmit) : '暂无提交';

        hdr.appendChild(left);
        hdr.appendChild(timeSpan);
        card.appendChild(hdr);

        var listEl = document.createElement('mdui-list');
        for (var j = 0; j < s.files.length; j++) {
          var f = s.files[j];
          var item = document.createElement('mdui-list-item');

          var icon = document.createElement('mdui-icon');
          icon.setAttribute('name', getFileIcon(f.name));
          icon.setAttribute('slot', 'icon');
          icon.className = 'file-icon';
          item.appendChild(icon);

          var info = document.createElement('div');
          info.innerHTML = '<div class="file-info-name">' + escapeHtml(f.name) + '</div>' +
            '<div class="file-info-meta">' + formatSize(f.size) + ' - ' + formatTime(f.modifiedAt) + '</div>';
          item.appendChild(info);

          var btn = document.createElement('mdui-button');
          btn.setAttribute('slot', 'end-icon');
          btn.setAttribute('variant', 'outlined');
          btn.style.fontSize = '12px';
          btn.textContent = '下载';
          btn.addEventListener('click', (function(sn, fn) { return function() { downloadClassFile(sn, fn); }; })(s.name, f.name));
          item.appendChild(btn);

          listEl.appendChild(item);
          listEl.appendChild(document.createElement('mdui-divider'));
        }
        card.appendChild(listEl);
        content.appendChild(card);
      }
    }

    searchInput.addEventListener('input', function() {
      var q = searchInput.value.toLowerCase().trim();
      if (!q) { render(students); return; }
      var filtered = [];
      for (var i = 0; i < students.length; i++) {
        var s = students[i];
        var matchedFiles = [];
        for (var j = 0; j < s.files.length; j++) {
          if (s.files[j].name.toLowerCase().indexOf(q) !== -1 || s.name.toLowerCase().indexOf(q) !== -1) {
            matchedFiles.push(s.files[j]);
          }
        }
        filtered.push({ name: s.name, fileCount: s.fileCount, files: matchedFiles, lastSubmit: s.lastSubmit });
      }
      render(filtered);
    });
    render(students);
  }

  function downloadClassFile(studentName, filename) {
    window.open(API_BASE + '/api/class/download/' + encodeURIComponent(studentName) + '/' + encodeURIComponent(filename) + '?token=' + TOKEN);
  }

  function escapeHtml(str) { var div = document.createElement('div'); div.textContent = str; return div.innerHTML; }

  loadWall();
</script>
