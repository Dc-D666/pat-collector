---
import Layout from '../layouts/Layout.astro';
---

<Layout title="登录">
  <div class="login-bg">
    <div class="login-box">
      <div class="login-logo">
        <mdui-icon name="smart_display" class="logo-icon"></mdui-icon>
        <h1 class="logo-title">PatPlayer</h1>
        <p class="logo-subtitle">高中AI社团 - 作品收集管理系统</p>
      </div>

      <mdui-card variant="elevated" class="login-card">
        <h2 class="form-title" id="formTitle">
          <mdui-icon name="lock" class="title-lock"></mdui-icon>登录
        </h2>

        <form id="authForm" class="auth-form">
          <mdui-select id="className" label="选择班级" variant="outlined" required>
            <mdui-menu-item value="">请选择班级</mdui-menu-item>
          </mdui-select>
          <mdui-text-field id="name" label="真实姓名" variant="outlined" maxlength="50" required></mdui-text-field>
          <mdui-text-field id="last4" label="学号后4位" variant="outlined" maxlength="4" pattern="[0-9]{4}" required></mdui-text-field>
          <mdui-text-field id="password" type="password" label="密码" variant="outlined" required minlength="4"></mdui-text-field>

          <div id="registerHint" class="register-hint">注册后初始密码为 <b>123456</b>，请登录后修改</div>
          <div id="errorMsg" class="form-error"></div>
          <div id="successMsg" class="form-success"></div>

          <mdui-button type="submit" variant="filled" full-width id="submitBtn">登录</mdui-button>
        </form>

        <div class="toggle-row">
          <span id="toggleText">还没有账号？</span>
          <mdui-button variant="text" id="toggleBtn">立即注册</mdui-button>
        </div>
      </mdui-card>

      <p class="login-footer">patplayer.com - 同班同学可互相查看</p>
    </div>
  </div>
</Layout>

<style>
  .login-bg { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:16px; background:linear-gradient(135deg, var(--mdui-color-primary-container, #e3f2fd), var(--mdui-color-surface, #ffffff)); }
  .login-box { width:100%; max-width:420px; }
  .login-logo { text-align:center; margin-bottom:32px; }
  .logo-icon { font-size:64px; color:var(--mdui-color-primary); }
  .logo-title { font-size:28px; font-weight:700; margin:8px 0 0; color:var(--mdui-color-on-surface); }
  .logo-subtitle { color:var(--mdui-color-on-surface-variant); margin:4px 0 0; }
  .login-card { padding:24px; }
  .form-title { font-size:18px; font-weight:600; text-align:center; margin:0 0 20px; }
  .title-lock { vertical-align:middle; margin-right:4px; }
  .auth-form { display:flex; flex-direction:column; gap:16px; }
  .register-hint { font-size:12px; color:var(--mdui-color-on-surface-variant); display:none; }
  .form-error { color:var(--mdui-color-error); font-size:14px; display:none; }
  .form-success { color:var(--mdui-color-primary); font-size:14px; display:none; }
  .toggle-row { text-align:center; margin-top:16px; font-size:14px; color:var(--mdui-color-on-surface-variant); }
  .login-footer { text-align:center; font-size:12px; color:var(--mdui-color-on-surface-variant); margin-top:16px; }
</style>

<script>
  const API_BASE = window.location.origin;
  let isRegister = false;

  function loadClasses() {
    const select = document.getElementById('className');
    for (let year = 25; year <= 26; year++) {
      const max = year === 25 ? 24 : 25;
      for (let i = 1; i <= max; i++) {
        const cls = `${year}${String(i).padStart(2, '0')}`;
        const item = document.createElement('mdui-menu-item');
        item.value = cls;
        item.textContent = `${cls} 班（${year === 25 ? '高二' : '高一'}）`;
        select.appendChild(item);
      }
    }
  }
  loadClasses();

  // 切换登录/注册
  document.getElementById('toggleBtn').addEventListener('click', () => {
    isRegister = !isRegister;
    const submitBtn = document.getElementById('submitBtn');
    const toggleText = document.getElementById('toggleText');
    const toggleBtn = document.getElementById('toggleBtn');
    const hint = document.getElementById('registerHint');

    if (isRegister) {
      submitBtn.textContent = '注册';
      toggleText.textContent = '已有账号？';
      toggleBtn.textContent = '去登录';
      hint.style.display = 'block';
    } else {
      submitBtn.textContent = '登录';
      toggleText.textContent = '还没有账号？';
      toggleBtn.textContent = '立即注册';
      hint.style.display = 'none';
    }
    document.getElementById('errorMsg').style.display = 'none';
    document.getElementById('successMsg').style.display = 'none';
  });

  // 提交
  document.getElementById('authForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById('submitBtn');
    const errorEl = document.getElementById('errorMsg');
    const successEl = document.getElementById('successMsg');

    submitBtn.loading = true;
    submitBtn.textContent = isRegister ? '注册中...' : '登录中...';
    errorEl.style.display = 'none';
    successEl.style.display = 'none';

    const className = document.getElementById('className').value;
    const name = document.getElementById('name').value.trim();
    const last4 = document.getElementById('last4').value;
    const password = document.getElementById('password').value;

    try {
      const endpoint = isRegister ? '/api/auth/register' : '/api/auth/login';
      const res = await fetch(`${API_BASE}${endpoint}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ className, name, last4, password }),
      });
      const data = await res.json();

      if (res.ok && data.success) {
        localStorage.setItem('patplayer_token', data.token);
        if (isRegister) {
          successEl.textContent = '注册成功！初始密码 123456，即将跳转...';
          successEl.style.display = 'block';
          setTimeout(() => { window.location.href = '/dashboard'; }, 1000);
        } else {
          window.location.href = '/dashboard';
        }
      } else {
        errorEl.textContent = data.error || '操作失败';
        errorEl.style.display = 'block';
      }
    } catch (err) {
      errorEl.textContent = '网络错误，请检查连接';
      errorEl.style.display = 'block';
    }
    submitBtn.loading = false;
    submitBtn.textContent = isRegister ? '注册' : '登录';
  });
</script>
