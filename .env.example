# 服务端口（默认 3001，与宝塔 nginx 反代一致）
PORT=3001

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pat
DB_USER=pat
DB_PASSWORD=change-me

# Token 签名密钥（生产环境务必改为强随机值，勿用默认/示例值）
TOKEN_SECRET=please-change-me-to-a-long-random-string

# 上传大小上限（MB），需与 nginx client_max_body_size 对齐
MAX_UPLOAD_MB=200

# 每用户文件总容量（MB，默认 1GB；超限提示联系频道主扩容）
MAX_USER_STORAGE_MB=1024

# 每人作品文件总数上限（删除可释放名额）
MAX_FILES_PER_USER=20

# 每人轻应用总数上限（删除可释放名额）
MAX_APPS_PER_USER=20

# 已登录用户每人每天上传次数上限（含删除）
MAX_UPLOADS_PER_DAY=20

# 访客直传（无 QQ）每人每天上传次数上限（单次大小仍受 MAX_UPLOAD_MB 限制）
GUEST_MAX_UPLOADS_PER_DAY=5

# 访客删除安全密码：提交时未设置密码的用户，删除文件时使用的默认密码。
# 注意：默认密码写在客户端提示里等于公开——留空=不设防，建议用户设置专属密码
GUEST_DEFAULT_PASSWORD=nanfang1958

# 管理后台：管理员 QQ tiny_id 白名单（逗号分隔）。QQ 登录绑定时 tiny_id 命中自动成为管理员。
# 获取自己的 tiny_id：登录后由管理员在后台「用户管理」查询，或查库 users.qq_tiny_id
ADMIN_QQ_TINY_IDS=

# 上传前磁盘自检：服务器磁盘剩余空间低于该值（GB）时拒绝上传，提示联系频道主扩容
MIN_FREE_DISK_GB=2

# 文件存储目录（相对项目根）
STORAGE_DIR=storage/uploads

# QQ 扫码登录会话目录（相对项目根）
QQ_SESSIONS_DIR=storage/qq-sessions

# 可选：限定 QQ 登录到某个频道（guild_id）；留空 = 不校验频道成员
GUILD_ID=

# NFTI 跨站体验（第1章实操任务）：
# PAT_TICKET_SECRET 必须与 NFTI 侧 docker-compose.yml 的 PAT_TICKET_SECRET 一致
PAT_TICKET_SECRET=
# NFTI 库只读连接（判定"已体验"；账号需有 nfti 库 SELECT 权限）
NFTI_DB_HOST=127.0.0.1
NFTI_DB_PORT=3306
NFTI_DB_NAME=nfti
NFTI_DB_USER=nfti
NFTI_DB_PASSWORD=

# DeepSeek 内容审查（仅上传 HTML 文件时调用；key 保密，勿提交仓库）
DEEPSEEK_API_KEY=
# 模型名（官方 API 为 deepseek-chat；按实际渠道配置）
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 审查开关：1 开（默认）/ 0 关
DEEPSEEK_AUDIT=1
